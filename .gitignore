# ── Data ─────────────────────────────────────────────────────────────────────
# Messidor-2 is access-controlled and must not be redistributed.
# See data/README.md for how to obtain it and where to place it.
data/raw/
data/processed/

# Manual backups of data/ sit outside the two rules above and would otherwise be
# committed in full — 3.3 GB of licensed images. Catch the usual duplicate names.
data copy/
data_copy/
data-backup/
data.bak/

# ── Model weights ────────────────────────────────────────────────────────────
# Frozen pretrained encoders (gated downloads) — see encoders/README.md
encoders/**/*.pth
encoders/**/*.safetensors
encoders/**/*.bin
# Our trained generators — see models/README.md
models/**/*.pt

# ── Experiment outputs ───────────────────────────────────────────────────────
# Regenerated by experiments/E*.py; only curated copies in report/ are tracked.
# Ignore the contents but keep the directory skeleton, so a fresh clone has
# somewhere to write without creating it first.
experiments/results/**/*
!experiments/results/**/
!experiments/results/**/.gitkeep

# ── Run logging ──────────────────────────────────────────────────────────────
wandb/
!wandb/README.md

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/

# ── OS / editor ──────────────────────────────────────────────────────────────
.DS_Store
.claude/worktrees/
